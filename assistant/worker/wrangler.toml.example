# Vorlage. Kopieren nach wrangler.toml, dann anpassen. Kein Geheimnis in diese Datei schreiben!
# Mit Workers AI ist kein KI-Schlüssel nötig. Nur bei LLM_PROVIDER = "openai": npx wrangler secret put LLM_API_KEY
name = "jenaisystems-assistant"
main = "src/index.js"
compatibility_date = "2026-10-01"

# Liefert das Chat-Widget unter https://IHR-WORKER/jenaisystems-chat.js aus.
[assets]
directory = "../widget"

# Cloudflare Workers AI – kostenloses Kontingent 10.000 Neurons/Tag, kein zweites Konto nötig.
[ai]
binding = "AI"

[vars]
LLM_PROVIDER = "workers-ai"                   # "workers-ai" (Standard) oder "openai" (OpenAI-kompatibel, z. B. Mistral)
WORKERS_AI_MODEL = "@cf/mistralai/mistral-small-3.1-24b-instruct"
WORKERS_AI_FALLBACK_MODEL = "@cf/meta/llama-3.3-70b-instruct-fp8-fast"   # leer lassen ("") = kein Ersatzmodell
GLOBAL_DAILY_CAP = "45"                       # Antworten pro Tag über alle Kunden – bleibt im Gratis-Kontingent
GLOBAL_MONTHLY_CAP = "1300"                   # harte Obergrenze über alle Kunden zusammen
# Nur für LLM_PROVIDER = "openai":
# LLM_BASE_URL = "https://api.mistral.ai/v1"
# LLM_MODEL = "mistral-small-latest"
LOG_QUESTIONS = "false"                       # anonymes Fragen-Log nur mit "true" UND logQuestions beim Kunden

# Optional: KV für Monatszähler (empfohlen) und anonymes Fragen-Log.
# Anlegen mit: npx wrangler kv namespace create USAGE   und die ID hier eintragen.
# [[kv_namespaces]]
# binding = "USAGE"
# id = "HIER_KV_ID"

# Geheimnisse (über wrangler secret put, NICHT hier):
#   LLM_API_KEY         nur für LLM_PROVIDER = "openai": Schlüssel des Anbieters
#   ADMIN_TOKEN         für /api/report
