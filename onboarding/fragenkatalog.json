    {
      "id": "telefon",
      "titel": "9. Telefonassistent (nur wenn gewünscht)",
      "fragen": [
        {
          "id": "telefon_aktiv",
          "label": "Möchten Sie einen KI-Telefonassistenten, der Anfragen aufnimmt?",
          "typ": "boolean",
          "pflicht": false,
          "hilfe": "Er nimmt Anrufe an, wenn niemand rangeht oder außerhalb der Öffnungszeiten, notiert Anliegen, Name und Rückrufnummer und schickt Ihnen eine Zusammenfassung. Er ruft nie selbst an und nennt am Telefon keine Preise."
        },
        {
          "id": "telefon_wann",
          "label": "Wann soll er Anrufe annehmen?",
          "typ": "select",
          "optionen": [
            "nur wenn niemand nach 20–25 Sekunden abnimmt",
