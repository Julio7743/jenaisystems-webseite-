          "label": "Link zum Impressum",
          "typ": "url",
          "pflicht": true
        },
        {
          "id": "datenschutz_url",
          "label": "Link zur Datenschutzerklärung",
          "typ": "url",
          "pflicht": true
        },
        {
          "id": "fragen_auswerten",
          "label": "Dürfen gestellte Fragen anonymisiert für einen Monatsbericht gespeichert werden?",
          "typ": "boolean",
          "pflicht": false,
          "hilfe": "Telefonnummern und E-Mail-Adressen werden vorher entfernt. Muss in Ihrer Datenschutzerklärung stehen."
        }
      ]
    },
    {
