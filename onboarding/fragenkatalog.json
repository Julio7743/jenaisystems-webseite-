            "beides"
          ],
          "pflicht": false
        },
        {
          "id": "telefon_begruessung",
          "label": "Eigener Begrüßungssatz (optional)",
          "typ": "text",
          "pflicht": false,
          "hilfe": "Der Hinweis auf die KI, „das Gespräch wird nicht aufgenommen“ und der 112-Hinweis werden immer automatisch ergänzt und lassen sich nicht abschalten."
        },
        {
          "id": "telefon_ort_abfragen",
          "label": "Soll der Assistent nach dem Ort fragen (z. B. weil Sie beim Kunden vor Ort arbeiten)?",
          "typ": "boolean",
          "pflicht": false
        },
        {
          "id": "telefon_nicht_im_angebot",
          "label": "Was wird oft angefragt, das Sie NICHT anbieten?",
          "typ": "list",
          "pflicht": false,
          "beispiel": "Lieferung\nglutenfreie Backwaren"
        },
        {
          "id": "telefon_dringend",
          "label": "Stichworte für dringende Fälle Ihres Betriebs",
          "typ": "list",
          "pflicht": false,
          "hilfe": "Dann wird die Anfrage als HOCH markiert und Sie bekommen zusätzlich eine Sofortnachricht.",
          "beispiel": "Großbestellung morgen\nBaustelle offen"
        },
        {
          "id": "telefon_wasser_relevant",
          "label": "Kann bei Ihnen ein Wasserschaden/Rohrbruch ein Thema sein?",
          "typ": "boolean",
          "pflicht": false,
          "hilfe": "z. B. Maler, Handwerk, Hausverwaltung. Dann gibt der Assistent einen Sicherheitshinweis (Hauptwasserhahn) und markiert dringend."
        },
        {
          "id": "telefon_gas_nummer",
          "label": "Nummer des Gas-Entstörungsdienstes in Ihrer Region (bitte selbst prüfen)",
          "typ": "tel",
          "pflicht": false
        },
        {
          "id": "telefon_rueckruf_zusage",
          "label": "Was darf der Assistent zum Rückruf zusagen?",
          "typ": "text",
          "pflicht": false,
