{
  "version": 1,
  "titel": "JenAiSystems Fragenkatalog für Ihren KI-Assistenten",
  "einleitung": "Mit Ihren Antworten richten wir den Chat-Assistenten auf Ihrer Website und auf Wunsch den Telefonassistenten ein. Der Assistent antwortet später NUR mit dem, was hier steht. Was fehlt, beantwortet er nicht, sondern verweist auf Sie. Pflichtfelder sind mit * markiert.",
  "abschnitte": [
    {
      "id": "betrieb",
      "titel": "1. Ihr Betrieb",
      "fragen": [
        {
          "id": "betrieb_name",
          "label": "Name des Betriebs",
          "typ": "text",
          "pflicht": true,
          "beispiel": "Bäckerei Muster"
        },
        {
          "id": "betrieb_branche",
          "label": "Branche",
          "typ": "text",
          "pflicht": true,
          "beispiel": "Bäckerei und Café"
        },
        {
          "id": "betrieb_beschreibung",
          "label": "Beschreiben Sie Ihren Betrieb in 2–4 Sätzen",
          "typ": "textarea",
          "pflicht": true,
          "hilfe": "So, wie Sie es einem neuen Kunden am Telefon erzählen würden."
        },
        {
          "id": "betrieb_adresse",
          "label": "Adresse",
          "typ": "textarea",
          "pflicht": false
        },
        {
          "id": "betrieb_anfahrt",
          "label": "Anfahrt, Parken, Barrierefreiheit",
          "typ": "textarea",
          "pflicht": false,
          "beispiel": "Haltestelle Markt (Linie 3), 2 Parkplätze im Hof, Eingang ebenerdig"
        },
        {
          "id": "betrieb_gebiet",
          "label": "Für welches Gebiet sind Sie tätig?",
          "typ": "text",
          "pflicht": false,
          "beispiel": "Lieferung im Umkreis von 10 km"
        },
        {
          "id": "betrieb_besonderheiten",
          "label": "Was macht Sie besonders?",
          "typ": "list",
          "pflicht": false,
          "hilfe": "Ein Punkt pro Zeile. Nur Dinge, die nachweisbar stimmen."
        }
      ]
    },
    {
      "id": "leistungen",
      "titel": "2. Leistungen und Preise",
      "fragen": [
        {
